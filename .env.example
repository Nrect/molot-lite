# Copy to .env and adjust. Every variable is read by internal/platform/config.

# TCP port the HTTP server listens on.
HTTP_PORT=8080

# Postgres DSN; matches docker-compose.yml defaults.
DATABASE_URL=postgres://molotlite:molotlite@localhost:5432/molotlite?sslmode=disable

# HS256 signing key, at least 32 bytes. Generate one:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-secret-of-32-bytes-or-more

# json (prod) or text (local development).
LOG_FORMAT=text

# bcrypt cost for password hashing (4..31).
BCRYPT_COST=10

# Comma-separated allowlist of browser origins, e.g.
#   CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Empty keeps CORS off: no cross-origin browser access at all.
CORS_ORIGINS=

# Per-IP rate limit on the auth endpoints (register/login): sustained
# requests per second plus an initial burst. RATE_LIMIT_RPS=0 disables.
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=5

# Telegram outbid notifications. Set both or neither; when empty the
# notifications land in the log instead of a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production compose only (docker-compose.prod.yml): database password.
# POSTGRES_PASSWORD=
